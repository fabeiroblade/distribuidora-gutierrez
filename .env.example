# ---------------------------------------------------------------------------
# Contacto — se leen en build. En Vercel: Project Settings > Environment Variables.
# Tras cambiarlas hay que volver a desplegar para que tomen efecto.
# ---------------------------------------------------------------------------

# WhatsApp con codigo de pais, solo digitos (503 = El Salvador). Sin + ni espacios.
# 50374831791 = 7483-1791
NEXT_PUBLIC_WHATSAPP=50374831791

# Telefonos separados por coma. El primero es el principal (boton "Llamar").
# Se muestran con el +503 antepuesto automaticamente.
NEXT_PUBLIC_TELEFONOS=7483-1791, 2262-5041, 7527-8155

NEXT_PUBLIC_EMAIL=distribuidoragutierrez140724@gmail.com

# Perfiles de redes: URL completa
NEXT_PUBLIC_INSTAGRAM=https://www.instagram.com/distribuidoragutierrez140724
# Facebook: sin perfil por ahora. Si se deja vacio, el boton no aparece en el sitio.
NEXT_PUBLIC_FACEBOOK=
# Opcional: si se deja vacio, el boton no aparece
NEXT_PUBLIC_TIKTOK=

NEXT_PUBLIC_DIRECCION=San Salvador, El Salvador
NEXT_PUBLIC_HORARIO=Lunes a viernes 8:00 a.m. – 5:00 p.m. · Sábados 8:00 a.m. – 12:00 m.
# Opcional: enlace a Google Maps. Si se deja vacio, no se muestra el boton "Ver mapa"
NEXT_PUBLIC_MAPA=

# Dominio final del sitio — usado por el sitemap y las etiquetas Open Graph
NEXT_PUBLIC_SITE_URL=https://distribuidora-gutierrez.vercel.app

# ---------------------------------------------------------------------------
# Supabase — catálogo, imágenes y usuarios del panel
# Se sacan de: Supabase > Project Settings > API
# ---------------------------------------------------------------------------

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# CLAVE SECRETA. Da acceso total saltándose los permisos: solo se usa en el
# servidor para crear y eliminar usuarios. Nunca la compartas ni la subas a Git.
SUPABASE_SERVICE_ROLE_KEY=
